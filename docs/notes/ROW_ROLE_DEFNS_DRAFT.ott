%% ROW_ROLE_DEFNS_DRAFT.ott
%%
%% Minimal row + role judgement draft, in ett.ott-style syntax.
%%
%% This is NOT an attempt to extend corespec-roles/spec/ett.ott itself.
%% It is a polytropos-local formal sketch, written in the same surface
%% syntax so that the judgement shapes are concrete and reviewable.
%%
%% Intent / scope (matches ROW_ROLE_JUDGEMENT_SKETCH.md §5):
%%   - closed vs open row kinds
%%   - row inclusion  r1 ⊆ r2
%%   - a couple of widening rules
%%   - the two-point role lattice Nom ≤ Rep
%%   - role-subsumption for row constraints (the Sub-style rule)
%%
%% Deliberately left out (see ROW_ROLE_JUDGEMENT_SKETCH.md §4):
%%   - per-label roles
%%   - full row-polymorphic quantification
%%   - row pattern matching
%%   - full ICFP 2019 dependent-type apparatus
%%   - OCaml's Reither / object-row encoding
%%   - any completeness/soundness claim

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 0. Reference notes (not part of Ott grammar)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Row algebra source:
%%   OCaml typechecker, typing/ctype.ml:
%%     merge_row_fields / merge_rf
%%     subtype_row
%%     unify_row / unify_row_field
%%     row_rep, row_more, row_closed, row_fixed
%%     static_row
%%   Plus the polytropos note:
%%     docs/notes/OCAML_ROW_TAIL_SUBTYPE_MECHANISM.md
%%
%% Role/erasure source:
%%   Weirich et al., "A Role for Dependent Types in Haskell" (ICFP 2019)
%%   and its Coq/Ott development at ~/src/corespec-roles.
%%   Imported pieces:
%%     - two-role lattice Nom/Rep with <= R1 R2
%%     - definitional equality a == b : A / R
%%     - Sub rule for role-subsumption
%%     - separate roleing judgement
%%     - erase_tm / erase_constraint

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 1. Metavariables
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% We do not re-define the full ICFP 2019 metavar set here.
%% We only introduce the metavariables this draft needs.

metavar label, l, m, n ::= {{ com row labels }}
  {{ lex alphanum }}

metavar tvar, ρ, α, β ::= {{ com row tail variables }}
  {{ lex alphanum }}

indexvar index, i ::= {{ com literal positions }}
  {{ tex \mathit{[[index]]} }}
  {{ coq nat }}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 2. Row kinds
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% A row is either closed or open.
%%
%% This is the OCaml-flavored split:
%%   closed row  ~ row_fields only, tail effectively Tnil / fixed
%%   open row    ~ row_fields plus a tail variable ρ
%%
%% In this draft we treat a row as a separate syntactic category because
%% polytropos's current shipped row vocabulary has no row tail at all.
%% The immediate goal of this draft is to state that missing piece
%% concretely, not to claim it is already implemented.

row, r, s ::= {{ com rows }}

  %% closed row: finite ordered map from labels to types.
  %% Corresponds to OCaml's static-row/end-of-row case where tail
  %% is not a unification variable.
  ( l :> A  ,  r )        ::   :: RowCons

  %% empty closed row. Corresponds to an empty known field set.
  ()                      ::   :: RowNil

  %% open row: known fields plus a row tail variable.
  %% The tail stands for "zero or more additional unknown labels".
  ( l :> A  ,  r )  ρ     :: S :: RowOpen

  %% An open row written with an explicit tail binder, for use in
  %% contexts where we want the tail variable to be syntactically
  %% apparent. This is the shape we expect the plugin/constraint
  %% layer to manipulate.
  ρ                       ::   :: RowTail

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 3. Row inclusion judgement — Reading B (constraint-emission-aware)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% GOAL (from the session decision):
%%   The inclusion judgement fires on immediate shapes AND on open rows
%%   whose tails are NOT yet solved. When it encounters an unsolved tail,
%%   it does NOT solve the tail itself; it delegates the unsolved tail to
%%   constraint emission.

%% Central judgement of this draft:
%%
%%     r1 ⊆ r2
%%
%% Read: a value whose row is r1 can be used where a value whose row
%% is r2 is expected.
%%
%% This is NOT equality. It is the relation computed (with constraints)
%% by OCaml's subtype_row after merging fields with merge_row_fields.
%%
%% Why Reading B (vs Reading A):
%%   Reading A (judgement over immediate shapes only) would say:
%%     "r1 ⊆ r2 only applies when both r1 and r2 are concrete closed rows,
%%      or when the tail relationship is already known."
%%   Reading B says:
%%     "r1 ⊆ r2 applies whenever the known-field decomposition succeeds,
%%      EVEN IF the tails are still variables. The tail relationship becomes
%%      a constraint that the constraint layer discharges later."
%%   Reading B is required for row-polymorphic functions to use the
%%   judgement, because a row-polymorphic function's argument row is a
%%   variable, not a concrete shape.
%%
%% Important design alignment with OCaml:
%%   - Inclusion decomposes label-by-label after the two field sets are
%%     aligned.
%%   - Leftover fields on one side are handled by the open/closed shape
%%     of the other side's tail.
%%   - The tail is not magic; inclusion does not "unify away" a closed row
%%     into an open one.

defn
r1 ⊆ r2 ::   :: RowIncl :: 'RowIncl_'
{{ com row inclusion }}
{{ tex [[r1]] \\subseteq [[r2]] }}
by

%% Empty closed rows are included in anything that admits no
%% extra-label mismatch on the closed side.
%% This is the empty-closed-row base case (closed-to-closed nil).
()
  ⊆ r

%% A known field must appear on the right with a compatible type.
%% In this draft, "compatible type" is represented by equality A == B
%% at the relevant role. This is the label-by-label decomposition
%% that OCaml's merge_row_fields + subtype_row performs.
%%
%% NOTE: This rule applies once per matching label, regardless of whether
%% the remaining tails are closed or open. The judgement does not require
%% the tails to be solved before recursing.
( l :> A  ,  r1 )  ⊆  ( l :> B  ,  r2 )
  -----------------------------------------
  r1 ⊆ r2

%% Closed-to-open widening.
%% A fully known closed row can be widened to an open row whose known
%% part is at least as big. In OCaml terms, this is the direction
%% where a static row can be seen as an open row with a fresh/bound
%% tail variable.
%%
%% Under Reading B, this rule is a widening rule inside the judgement,
%% NOT a claim that the closed row was already open. See §6.
r  ⊆  ( r )  ρ

%% Open-to-open inclusion — Reading B version.
%% Two open rows are included when their known fields align and their
%% tails can be merged.
%%
%% Under Reading B, the tail merge is NOT performed by this judgement.
%% The judgement emits the tail relationship ρ1 ⊆₊ ρ2 as a constraint for
%% the constraint layer to discharge later. This is the "both sides have
%% row variable" case that Reading A would have refused or made conditional.
%%
%% Falsifiability test for Reading B:
%%   If a row-polymorphic function f : ∀ ρ. { a : Int | ρ } → ... is applied
%%   to an argument whose row is { a : Int, b : String | ρ' }, the judgement
%%   must be able to fire without ρ and ρ' already being unified. Reading B
%%   allows this because the tail relationship becomes a constraint, not a
%%   precondition on the judgement.
( r1 )  ρ1  ⊆  ( r2 )  ρ2
  -----------------------------
  r1 ⊆ r2      ρ1 ⊆₊ ρ2

%% Closed-row inclusion into an open row with a DIFFERENT known part.
%% This is the case Reading A often mishandles: a closed row { a : Int }
%% being used where an open row { b : String | ρ } is expected.
%%
%% Under Reading B, this becomes two constraints:
%%   1. The known-field decomposition may fail (if a label is missing on
%%      the open side), in which case inclusion fails.
%%   2. If the known fields are compatible, the closed tail must widen to
%%      the open tail, which is a tail judgement ρ_closed ⊆₊ ρ_open.
%% This rule is stated here to expose the case explicitly; whether it is
%% derivable from the rules above is a separate question (see §10).
%% NOTE: This rule is deliberately provisional. See §10.
( l1 :> A  ,  r1 )  ⊆  ( l2 :> B  ,  r2 )  ρ
  ---------------------------------------------
  ... (label compatibility condition) ...   r1 ⊆ ( r2 ) ρ   ρ_closed ⊆₊ ρ

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 4. Row-tail interaction judgements — §2/§3 boundary contract
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% GOAL (from the session decisions):
%%   - The row-shape layer is row-polymorphic in its tails, so the tail is
%%     NOT resolved inside the row-shape layer.
%%   - The inclusion judgement (§3) therefore fires on open rows whose tails
%%     are NOT yet solved, and leaves the tail unsolved.
%%   - The row-shape layer hands the tail to the constraint layer as a thing
%%     the constraint layer has to carry.
%%   - The constraint layer emits deferred constraints / unifier work to solve
%%     the tail, rather than the inclusion judgement solving it inline.
%%
%% This is the §2/§3 boundary contract stated together, because the two
%% decisions are the same decision seen from opposite sides of the boundary.

%% Terminology (used throughout §4 and §5):
%%   tail-nil   — static closed tail, no further labels possible
%%   tail-var ρ — open tail that can be widened/merged under constraint
%%   tail-fixed — closed/fixed tail that must not be widened

defn
ρ1 ⊆₊ ρ2 ::   :: RowTailIncl :: 'RowTailIncl_'
{{ com row tail inclusion judgement }}

%% THIS JUDGEMENT IS DECLARED, NOT SOLVED HERE.
%% The row-shape layer uses ρ1 ⊆₊ ρ2 to state that two open tails are
%% compatible under widening. The constraint layer is responsible for
%% actually discharging that obligation. See §4 for how the hand-off works.

%% Two identical open tail variables are compatible.
%% Constraint layer: may treat the tail as compatible without inventing a new
%% row. No constraint emission needed if the two sides are already the same
%% variable — the tail is already shared.
ρ  ⊆₊  ρ

%% An open tail variable may absorb a known closed remainder.
%% Constraint layer: this is the construction that makes open rows genuinely
%% open. Allowed, but as widening under constraint, not as unconditional row
%% equality. Emitting this as a constraint means the tail variable stays
%% unsolved until the closed remainder is accounted for.
ρ  ⊆₊  ()

%% A fresh open tail may be compatible with an existing tail variable.
%% Constraint layer: this is the widening step on the tail itself. The
%% judgement allows it; the plugin gates actual acceptance behind constraint
%% emission. Two distinct tail variables are NOT made equal by this judgement
%% alone — they become equal only if the constraint layer unifies them.
ρ  ⊆₊  ρ'

%% Closed/fixed tails must NOT be widened.
%% Constraint layer: if either side is a closed/fixed tail, the plugin:
%%   - must NOT turn it into an open tail
%%   - must NOT accept leftover fields against it unless it is already an
%%     open shape compatible under constraint
%% This mirrors OCaml's static_row / fixed_explanation gating.
ρ  ⊆₊  ρ'       when ρ is not tail-fixed, ρ' is tail-var

%% Non-identical closed/fixed tails are NOT silently merged.
%% Constraint layer: if both sides are closed/fixed and not identical, the
%% plugin either emits a deferred constraint or rejects the inclusion, exactly
%% as OCaml's subtype_row does for non-comparable tail constructors.
(ρ1 is tail-fixed, ρ2 is tail-fixed, ρ1 ≠ ρ2)
  ⊆₊  ρ2      ← deferred constraint or reject

%% HOW THE BOUNDARY HAND-OFF WORKS (§2/§3)
%%
%% When the inclusion judgement (§3) sees two open rows whose tails differ,
%% it does not try to solve the tail relationship. Instead:
%%   1. The row-shape layer decomposes the known fields (label-by-label).
%%   2. For the leftover tails, the row-shape layer emits a tail judgement
%%      ρ1 ⊆₊ ρ2 into the constraint layer's context.
%%   3. The constraint layer treats ρ1 ⊆₊ ρ2 as a constraint it must later
%%      discharge — by unifying the two tail variables, by widening one tail
%%      under the tail contract above, or by rejecting the inclusion if the
%%      tail shapes are non-comparable.
%%
%% This is what "handing the tail off to the constraint layer as a thing the
%% constraint layer has to carry" means in practice: the tail does not escape
%% the system, but it does escape the row-shape layer. The constraint layer
%% owns the tail until it is solved or rejected.

%% Operational note on constraint emission
%%
%% "Constraint emission" is the act of the plugin adding a wanted constraint
%% to GHC's constraint solver. In this draft it means: when the inclusion
%% judgement leaves a tail judgement unresolved, the plugin drops
%% ρ1 ⊆₊ ρ2 into the solver as a constraint the solver must discharge. The
%% plugin does NOT attempt to discharge it itself; that is the solver's job,
%% gated by the tail contract above.
%%
%% This is the plugin-boundary analogue of OCaml's subtype_row aborting to a
%% deferred constraint when the tails are not directly comparable.
%% See OCAML_ROW_TAIL_SUBTYPE_MECHANISM.md.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 5. Layer-appropriate specialization and the shared row-algebra layer
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% GOAL (from the session decision):
%%   The row algebra is factored into a third shared layer so that the
%%   row-shape layer and the constraint layer can each use layer-appropriate
%%   specializations of the same algebra without duplicating it.

%% Why this is a design decision, not an implementation detail:
%%   The row algebra (row union, row difference, label-set operations,
%%   tail construction) is used by at least two layers with different
%%   correctness criteria:
%%     - The row-shape / representation layer uses the algebra to construct
%%       Rep arrays and to decide field indices. It cares about layout
%%       performance, array compactness, and correct index assignment.
%%     - The constraint layer uses the algebra to decide what obligations to
%%       emit. It cares about decidability, termination, and soundness of
%%       the inclusion judgement — NOT about how fast an array gets laid out.
%%   If the two layers share a single implementation of the algebra, then
%%   either the representation layer's performance choices leak into the
%%   constraint layer, or the constraint layer's generality requirements
%%   force representation-layer overhead that is not needed.
%%   If the two layers each own a copy of the algebra, they can drift apart
%%   and the inclusion judgement can silently disagree with the actual
%%   representation layout.

%% The third shared layer:
%%   The candidate resolution is to factor the row-algebra primitives into
%%   a layer that both the row-shape layer and the constraint layer depend
%%   on, but that neither owns exclusively.
%%   In that arrangement:
%%     - The shared layer exposes the algebra as PURE operations on row
%%       shapes: union, difference, label membership, tail construction,
%%       closed vs open discrimination.
%%     - The row-shape layer uses those primitives to decide indices and
%%       to construct Rep.
%%     - The constraint layer uses the SAME primitives to decompose
%%       inclusion and to emit tail judgements, but applies its own
%%       constraint-emission policy on top.
%%   This is the cleanest dependency topology, but it is also the one that
%%   requires the most infrastructure before anything is working: you need
%%   the shared layer to exist before either consumer can be finished.

%% Trade-off statement (for the record):
%%   The alternative to the third shared layer is one of:
%%     (a) Row-shape layer owns the algebra; constraint layer calls in.
%%         Risk: constraint layer becomes dependent on representation-layer
%%         internals that it does not need.
%%     (b) Constraint layer owns the algebra; row-shape layer calls in.
%%         Risk: representation layer pays for generality it does not use.
%%     (c) Both own a copy. Risk: drift, silent disagreement.
%%   The session decision is to prefer (d) a third shared layer, with the
%%   understanding that (d) may be over-engineering if the algebra stays
%%   small enough. The draft leaves that judgment open.

%% This section is NOT a rule. It is the §5 design decision stated so that
%% later commits can check whether the code matches it.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 6. Widening as a derived/direct rule
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Widening is the constructive direction of inclusion.
%%
%% For this draft we state it directly rather than as a separate
%% metatheorem, because the point is to have something falsifiable:
%% the judgement set should be able to express "closed row → open row".
%%
%% Plugin boundary note:
%%   Widening in the judgement language is not the same as the plugin
%%   deciding a row is already widened. The plugin should treat widening
%%   as a controlled transition:
%%     - closed row → open row may be allowed when the row is not fixed
%%     - tail widening is allowed only through the tail contract in §4
%%     - once a row is fixed/closed, narrowing may be attempted but
%%       widening back out is not allowed by fiat

defn
r ⇝ w                ::   :: RowWiden :: 'RowWiden_'
{{ com row widening }}
{{ tex [[r]] \\rightsquigarrow [[w]] }}

%% Widen a closed row to an open row by attaching a tail variable.
r  ⇝  ( r )  ρ

%% Widen a tail variable into a larger tail variable.
%% This is the tail-only widening analogue.
ρ  ⇝  ρ'

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 7. Role lattice
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% We adopt the two-point role lattice from ICFP 2019.
%%
%%   Nom  -- nominal equality only; no coercion through abstraction
%%   Rep  -- representational equality; coercion-safe
%%
%% This is the lattice already present in corespec-roles/spec/ett.ott
%% as JSubRole / SubRole. We restate it here only so this draft is
%% self-contained.

defn
R1 ≤ R2  ::  :: SubRole :: 'SubRole_'
{{ com role subsumption }}
{{ tex [[R1]] \\leq [[R2]] }}

------------ :: NomBot
Nom  ≤  R

------------ :: RepTop
R  ≤  Rep

------------ :: Refl
R  ≤  R

R1 ≤ R2
R2 ≤ R3
--------- :: Trans
R1 ≤ R3

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 8. Row constraints
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Minimal row constraint forms for this draft.
%%
%% We do not commit to a full constraint language yet. We only add the
%% two shapes needed for the immediate question:
%%   - row equality
%%   - row inclusion
%%
%% The role index is kept on equality only, because the minimal
%% hypothesis is that inclusion is a structural relation, while
%% equality/coercion evidence may need a role.

constraint, φ ::= {{ com row constraints }}

  r1 ~ r2 : A / R     ::   :: RowEq
  {{ com row equality at role R }}

  r1 ⊆ r2             ::   :: RowInclC
  {{ com row inclusion constraint }}

  ( φ )               :: S :: RowCParen

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 9. Role-subsumption for row constraints
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% The key rule that imports the role lattice into the row-constraint
%% layer. It mirrors ICFP 2019's Sub rule, but restricted to the row
%% constraint forms this draft has.
%%
%% This is where closed-row equality vs closed-open compatibility may
%% acquire different roles:
%%   - exact closed-row equality is likely Nom
%%   - closed-row/compatible-open compatibility may be Rep under inclusion

defn
φ1 ≤ φ2  ::  :: RowConstrSub :: 'RowConstrSub_'
{{ com row constraint subsumption }}

%% Role-subsumption on row equality, exactly the ICFP 2019 Sub shape.
r ~ s : A / R1      R1 ≤ R2
---------------------------------
r ~ s : A / R2

%% Inclusion constraints do not change by role alone in this minimal
%% draft. That is a design choice, not a theorem. The draft leaves a
%% gap here on purpose: whether inclusion itself should be role-indexed
%% is one of the things this draft is meant to expose.
r1 ⊆ r2              r1 ⊆ r2
---------------------------------
r1 ⊆ r2

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 10. What this draft does and does not yet commit to
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% Commits to:
%%   - a closed vs open row distinction in the syntax
%%   - row inclusion as a judgement, not equality
%%   - at least one closed-to-open widening rule
%%   - the Nom ≤ Rep lattice
%%   - a role-subsumption rule for row equality
%%
%% Does not commit to:
%%   - whether polytropos will actually adopt row tails in code
%%   - how the tail judgement ρ1 ⊆₊ ρ2 is solved
%%   - per-label roles
%%   - row polymorphism
%%   - any claim that the above is a complete or proved system
%%
%% Open gap flagged by the §3 Reading B decision:
%%   The falsifiability criterion asks the draft to state "nominal closed-row
%%   equality" as well as closed-to-open widening. The draft currently has:
%%     - row INCLUSION as a judgement (§3), and
%%     - row EQUALITY as a CONSTRAINT FORM (§8), with role-subsumption
%%       on that constraint form (§9).
%%   It does NOT yet have a closed-row EQUALITY judgement distinct from
%%   inclusion. Whether that judgement is needed is exactly the question
%%   Reading B was meant to clarify: if inclusion is constraint-emission-
%%   aware, then the equality case may be subsumed by inclusion + role, or
%%   it may need its own rule. The draft leaves that question open rather
%%   than pretend it is settled.
%%
%% Alignment checks:
%%   - Row side: OCaml's merge_row_fields / subtype_row / unify_row
%%     semantics, as recorded in OCAML_ROW_TAIL_SUBTYPE_MECHANISM.md.
%%   - Role side: ICFP 2019 Sub rule and the Nom/Rep lattice from
%%     corespec-roles/spec/ett.ott (JSubRole / SubRole).
%%
%% Falsifiability criterion (from ROW_ROLE_JUDGEMENT_SKETCH.md §5):
%% If this draft cannot state closed-to-open widening and nominal
%% closed-row equality without stepping on itself, it is not ready.
%%
%% Plugin-facing falsifiability test:
%%   1. Can the draft state closed-to-open widening without pretending the
%%      tail judgement solves the tail?
%%   2. Can it state a closed-row equality case without collapsing closedness?
%%   3. Can it state which tail shapes the plugin may widen and which it must
%%      defer/reject?
%% If any of those is unclear, the draft is not yet usable as a plugin
%% boundary contract.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% 11. Boundary contract summary (plain terms)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%% This section restates the §2/§3/§4 decisions as a single boundary contract
%% between the row-shape layer and the constraint layer, so that a reader who
%% skipped the judgement rules can still see what the draft is committing to.
%%
%% The two-layer model:
%%   - The row-shape / representation layer owns row syntax, closed vs open
%%     distinction, known-field decomposition, and the widening rules that
%%     turn a closed row into an open row. It does NOT solve tail variables.
%%   - The constraint layer owns tail judgements ρ1 ⊆₊ ρ2, constraint emission,
%%     and the discharge of unsolved tail relationships. It does NOT own the
%%     row syntax or the field-index layout.
%%   - The shared row-algebra layer (§5) owns the pure row-algebra primitives
%%     (union, difference, label membership, tail construction, closed/open
%%     discrimination) that both layers call into, so neither layer
%%     independently re-derives the algebra.
%%
%% The hand-off:
%%   When the inclusion judgement §3 fires on two open rows with different
%%   tails, the row-shape layer:
%%     1. decomposes the known fields label-by-label
%%     2. emits ρ1 ⊆₊ ρ2 into the constraint layer as a constraint
%%     3. does NOT attempt to solve ρ1 ⊆₊ ρ2 itself
%%   The constraint layer then discharges ρ1 ⊆₊ ρ2 by:
%%     - unifying the two tail variables if they are the same, or
%%     - widening one tail under the §4 tail contract, or
%%     - rejecting the inclusion if the tail shapes are non-comparable
%%
%% What the plugin is responsible for:
%%   - inspecting the row shape and decomposing known fields
%%   - emitting tail judgements as constraints when the known-field
%%     decomposition succeeds but the tails are not identical
%%   - rejecting or deferring when the tail shapes are non-comparable
%%     (both sides closed/fixed and not identical)
%%
%% What the plugin is NOT responsible for:
%%   - solving unification of row-tail variables (that is the solver's job)
%%   - deciding field indices (that is the representation layer's job)
%%   - re-deriving the row algebra independently of the shared layer
%%   - pretending that widening is unconditional (it is gated by the §4
%%     tail contract)
%%
%% Dependency direction:
%%   - row-shape layer → shared row-algebra layer (calls in)
%%   - constraint layer  → shared row-algebra layer (calls in)
%%   - row-shape layer → constraint layer (hands off tail judgements)
%%   - constraint layer  → row-shape layer (no direct dependency; only
%%     receives emitted constraints)
%%   - shared row-algebra layer → neither consumer (pure, no dependency)
%%
%% This is the dependency topology the session decisions §2/§3/§4 imply.
%% Whether it is the right topology is still open (see §5's trade-off
%% statement). The draft commits to stating it, not to having implemented it.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%% end of draft
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
