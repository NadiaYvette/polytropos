{
  "extensions": [
    "BangPatterns",
    "DataKinds",
    "FlexibleContexts",
    "OverloadedRecordDot",
    "OverloadedStrings",
    "TypeOperators"
  ],
  "fixities": [
    "infixr 5 :=",
    "infixr 5 .=="
  ],
  "formatting": {
    "align": {
      "case": false,
      "class": false,
      "import-module": true,
      "import-spec": true,
      "let-binds": false,
      "limits": [
        12,
        30
      ],
      "record-fields": true,
      "where": false
    },
    "indent": {
      "case": 2,
      "class": 2,
      "do": 2,
      "let": 2,
      "multi-if": 2,
      "onside": 2,
      "where": 2
    },
    "options": {
      "align-sum-type-decl": false,
      "flexible-oneline": false,
      "preserve-vertical-space": true,
      "sort-import-lists": true,
      "sort-imports": true,
      "sort-pragmas": true,
      "split-language-pragmas": true
    },
    "penalties": {
      "case-alt": 10,
      "comment": 50,
      "eol": 50,
      "indent": 0,
      "infix-app": 10,
      "max-line-length": 1000,
      "line-length": 1,
      "nested-app": 10,
      "overhead": 0,
      "space": 1,
      "typed-expr": 10,
      "window": 1
    }
  },
  "style": "custom"
}
