-- Native packages. `ports/` is listed but intentionally empty today: a port
-- is added here only when it is developed in-tree (see docs/registers/
-- PACKAGES.md for the discriminator). `forks/` is never listed, because a
-- fork is built from its own checkout, not from this project.
--
-- `benchmark/variants/` is deliberately NOT listed. It is a standalone
-- cabal.project of its own, because every arm must be compiled at -O0 and in
-- isolation for the measurement to mean anything.
packages: packages/*/
          examples/*/

with-compiler: ghc-9.14.1

write-ghc-environment-files: always
-- cborg 0.2.10.0 and serialise 0.2.6.1 declare base < 4.22, but GHC 9.14
-- ships base 4.22 and the packages compile unchanged against it; the bound
-- predates the release and is metadata-only. Scoped to these two packages
-- so every other dependency's base bound stays enforced.
allow-newer: cborg:base, serialise:base, serialise:time, serialise:containers, serialise:bytestring, cborg:bytestring, cborg:containers, cborg:primitive, cborg:text
-- Same metadata-only situation, from the other side: persistent 2.18.1.0
-- caps template-haskell < 2.24 and aeson < 2.3, but compiles unchanged
-- against the template-haskell 2.24 / aeson 2.2.5.1 pair GHC 9.14 ships.
allow-newer: persistent:template-haskell
constraints: any.aeson ==2.2.5.1
-- rel8 1.8 (and its rel8-internal / opaleye / postgresql-simple / hasql
-- dependency cone) predates GHC 9.14's base 4.22; all compile unchanged
-- against the installed versions. rel8-internal 1.8 also needs the hasql
-- 1.x Statement API that hasql 2.x removed, so hasql is pinned to 1.9.3.2,
-- and the whole PostgreSQL stack is pinned to postgresql-binary 0.14.2
-- (0.15 removed the Monad Composite instance hasql 1.9's deriving needs;
-- 0.14.2 provides it and the valueParser API polytropos-hasql tests use).
allow-newer: rel8:base, rel8-internal:base, rel8-internal:hasql, rel8-internal:postgresql-binary, opaleye:base, postgresql-simple:base, postgresql-simple:template-haskell, postgresql-simple:containers, hasql:postgresql-binary, postgresql-binary:base, postgresql-binary:containers, postgresql-binary:bytestring, postgresql-binary:text, postgresql-binary:time, postgresql-binary:vector, postgresql-binary:hashable, postgresql-binary:scientific, postgresql-binary:aeson, postgresql-binary:base16, postgresql-binary:bytestring-strict-tree, postgresql-binary:case-insensitive, postgresql-binary:crypton, postgresql-binary:dlist, postgresql-binary:iproute, postgresql-binary:network-ip, postgresql-binary:these, postgresql-binary:uuid-types
constraints: any.hasql ==1.9.3.2, any.postgresql-binary ==0.14.2
