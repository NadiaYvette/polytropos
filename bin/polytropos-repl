#!/bin/sh
# polytropos-repl — Frictionless GHCi REPL preconfigured for Polytropos.Plugin
#
# Resolves the common GHCi traps:
# 1. Preloads -package polytropos-core and -package polytropos-plugin
# 2. Enables -fplugin=Polytropos.Plugin and -fobject-code
# 3. Enables -XDataKinds, -XOverloadedLabels, -XOverloadedRecordDot, -XTypeApplications
# 4. Imports Polytropos into the interactive scope

# This looks messy but the primary concern at the moment is capturing everything.

# polytropos-repl — Reproducible GHCi REPL for Polytropos.Plugin (GHC 10.1+ interactive hooks)
#
# Usage:
#   ./bin/polytropos-repl                 # Interactive REPL
#   ./bin/polytropos-repl --smoke-test    # Non-interactive verification of REC / REC_UPD / VAR / OpenRecord
#   GHC_VERSION=9.14.1 ./bin/polytropos-repl

set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GHC_VERSION="${GHC_VERSION:-10.1.20261105}"
GHC_BIN="${GHC_BIN:-ghc-$GHC_VERSION}"
JOBS="${JOBS:-$(nproc)}"
TARGET_COMPONENT="${TARGET_COMPONENT:-polytropos-generics polytropos-optics polytropos-profunctors}"

cd "$REPO_ROOT"

INIT_SCRIPT="$(mktemp "${TMPDIR:-/tmp}/polytropos-repl.XXXXXX.ghci")"
trap 'rm -f "$INIT_SCRIPT"' EXIT INT TERM

cat > "$INIT_SCRIPT" <<'EOF'
:set -XDataKinds -XOverloadedLabels -XOverloadedRecordDot -XTypeApplications -XTypeOperators -XViewPatterns
:set -fobject-code
import Polytropos
:set prompt "polytropos> "
:set prompt-cont "polytropos| "
EOF

SMOKE=0
if [ "${1:-}" = "--smoke-test" ]; then
    SMOKE=1
    shift
fi

run_repl() {
    cabal --with-compiler="$GHC_BIN" v2-repl \
        --allow-newer \
        --enable-shared \
        --enable-multi-repl \
        --jobs="$JOBS" \
        --semaphore \
        --build-depends=polytropos-core,polytropos-plugin \
        --repl-options="-ignore-dot-ghci -fplugin=Polytropos.Plugin -ghci-script $INIT_SCRIPT" \
        $TARGET_COMPONENT \
        "$@"
}

if [ "$SMOKE" -eq 1 ]; then
    run_repl "$@" <<'EOF'
:set -XDataKinds -XOverloadedLabels -XOverloadedRecordDot -XTypeApplications -XTypeOperators -XViewPatterns
:set -fobject-code
import Polytropos
:set prompt "polytropos> "
:set prompt-cont "polytropos| "
r = REC { x = 1 :: Int, y = True }
r.x
REC_UPD r { x = 42 }
(\(REC { x = a, y = b }) -> (a + 1, not b)) r
v = VAR { ok = REC { val = 200 :: Int } } :: Variant '["ok" ':= '["val" ':= Int], "err" ':= '["msg" ':= String]]
case v of { VAR { ok = REC { val = code } } -> code; _ -> 0 }
data Person = Person { name :: String, age :: Int } deriving OpenRecord
p = Person { name = "Alice", age = 30 :: Int }
p.name
:quit
EOF
else
    run_repl "$@"
fi
