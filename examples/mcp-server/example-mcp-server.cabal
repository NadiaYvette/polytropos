cabal-version: 3.14
name: example-mcp-server
version: 0.1.0.2
synopsis: Worked tutorial capstone: Federated Context & Memory MCP Server
description:
  Interactive tutorial capstone executable demonstrating a Model Context Protocol (MCP)
  server multiplexing Contextful codebase FTS5 search and Kioku agent memory recall
  with O(1) jump table dispatch and token-budget sub-row projection.
license: EUPL-1.2 OR Apache-2.0
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Network, AI
build-type: Simple

executable example-mcp-server
  default-language: GHC2021
  hs-source-dirs: src
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.19 && < 5,
    aeson >= 2.2 && < 2.3,
    bytestring >= 0.11 && < 0.13,
    text >= 2.0 && < 3,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2,
    polytropos-mcp >= 0.1 && < 0.2
