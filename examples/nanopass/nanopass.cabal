cabal-version: 3.14
name: example-nanopass
version: 0.1.0.0
synopsis: Worked tutorial example of a Nanopass compiler pass using polytropos
license: BSD-3-Clause
build-type: Simple

executable example-nanopass
  default-language: GHC2021
  hs-source-dirs: src
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.19 && < 5,
    polytropos-core,
    polytropos-plugin
