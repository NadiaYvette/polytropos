cabal-version: 3.14
name: example-nanopass
version: 0.1.0.1
synopsis: Worked tutorial example of a Nanopass compiler pass using polytropos
description:
  Interactive tutorial example demonstrating the Nanopass compiler pass architecture
  using @polytropos@ open variants and single-constructor peeling.
license: EUPL-1.2 OR Apache-2.0
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Compilers/Interpreters
build-type: Simple

executable example-nanopass
  default-language: GHC2021
  hs-source-dirs: src
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.19 && < 5,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2
