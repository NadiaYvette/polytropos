cabal-version: 3.14
name: example-effects
version: 0.1.0.0
synopsis: Worked tutorial example of Extensible Algebraic Effects & Higher-Kinded Ropes
description:
  Interactive tutorial companion executable demonstrating extensible arrow pipelines
  and higher-kinded ropes (kernmantle-polytropos architecture) with open rows.
license: EUPL-1.2 OR Apache-2.0
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Control, Effects
build-type: Simple

executable example-effects
  default-language: GHC2021
  hs-source-dirs: src
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base >= 4.19 && < 5,
    text >= 2.0 && < 3,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2
