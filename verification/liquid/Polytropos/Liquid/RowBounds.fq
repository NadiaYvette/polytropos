// Liquid-Fixpoint Horn Constraint verification for Polytropos row invariants
// Formally verified via Z3 SMT solver.

qualif NonNeg(v: int) { 0 <= v }
qualif InBounds(v: int, n: int) { v < n }
qualif Leq(v: int, n: int) { v <= n }
qualif Decrement(v: int, t: int) { v == t - 1 }

// Binders
bind 0 arity : {v : int | 0 <= v}
bind 1 slotIdx : {v : int | 0 <= v && v < arity}
bind 2 superArity : {v : int | 0 <= v}
bind 3 subArity : {v : int | 0 <= v && v <= superArity}
bind 4 projIdx : {v : int | 0 <= v && v < superArity}
bind 5 jumpTableSize : {v : int | 0 < v}
bind 6 variantTag : {v : int | 0 <= v && v < jumpTableSize}
bind 7 targetTag : {v : int | 0 <= v && v < variantTag}
bind 8 remappedTag : {v : int | v == variantTag - 1}

// Invariant 1: Record slot indexing is strictly in-bounds [0 <= i < arity]
constraint:
  env [0; 1]
  lhs {v : int | v = slotIdx}
  rhs {v : int | 0 <= v && v < arity}
  id 1 tag [1]

// Invariant 2: SubRow projection indices map into super-record bounds
constraint:
  env [2; 4]
  lhs {v : int | v = projIdx}
  rhs {v : int | 0 <= v && v < superArity}
  id 2 tag [2]

// Invariant 3: SubRow target arity is bounded by super arity
constraint:
  env [2; 3]
  lhs {v : int | v = subArity}
  rhs {v : int | 0 <= v && v <= superArity}
  id 3 tag [3]

// Invariant 4: Variant jump table dispatch index is strictly in-bounds [0 <= tag < tableSize]
constraint:
  env [5; 6]
  lhs {v : int | v = variantTag}
  rhs {v : int | 0 <= v && v < jumpTableSize}
  id 4 tag [4]

// Invariant 5: Peeling non-matching variant remapping never underflows [remappedTag >= 0]
constraint:
  env [5; 6; 7; 8]
  lhs {v : int | v = remappedTag}
  rhs {v : int | 0 <= v}
  id 5 tag [5]
