cabal-version: 3.14
name: polytropos-quickcheck
version: 0.1.0.0
build-type: Simple
synopsis: QuickCheck generators and slot-indexed shrinkers for polytropos
description:
  Satellite package integrating @polytropos@ open records and variants with
  QuickCheck property-based testing: 'Arbitrary (Record r)' generates each
  field value via its own 'Arbitrary' instance and packs the results into a
  contiguous 'SmallArray' payload, and shrinks each field slot independently
  (one field at a time) without a full combinatorial Cartesian product
  blowup. 'Arbitrary (Variant s)' uniformly selects a constructor tag index
  and generates that constructor's payload, and shrinks strictly within the
  active constructor branch.
license: BSD-3-Clause

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.QuickCheck
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    QuickCheck >= 2.14,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-quickcheck-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    QuickCheck,
    polytropos-core,
    polytropos-quickcheck,
    polytropos-plugin,
    tasty,
    tasty-hunit
