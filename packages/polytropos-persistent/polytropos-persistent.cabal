cabal-version: 3.14
name: polytropos-persistent
version: 0.1.0.0
build-type: Simple
synopsis: persistent PersistValue marshalling for polytropos open records
description:
  Satellite package bridging @polytropos@ open records with the Yesod
  ecosystem's @persistent@ relational database framework. 'PersistRow'
  provides fast marshalling of records to and from @['PersistValue']@ rows:
  'toPersistFieldsRecord' serializes the flat 'SmallArray' payload in row
  order, and 'fromPersistValuesRecord' reconstructs the record by filling
  the payload slots directly — no intermediate tuples. A 'PersistField'
  instance lets a whole record travel through persistent's value machinery
  as a 'PersistList', and 'PolyRowEntity' is a key-value wrapper in the
  shape of persistent's 'Entity'.
license: BSD-3-Clause

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Persistent
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    persistent >= 2.14,
    text,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-persistent-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    persistent,
    text,
    polytropos-core,
    polytropos-persistent,
    polytropos-plugin,
    tasty,
    tasty-hunit
