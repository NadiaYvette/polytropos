cabal-version: 3.14
name: polytropos-microlens
version: 0.1.0.0
build-type: Simple
synopsis: microlens integration for polytropos open records
description:
  Satellite package integrating @polytropos@ row-typed open records with
  @microlens@: class-based optics with zero transitive dependency bloat
  beyond @base@ and @microlens@ itself.
license: BSD-3-Clause

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Microlens
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    microlens >= 0.4,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-microlens-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    microlens,
    polytropos-core,
    polytropos-microlens,
    polytropos-plugin,
    tasty,
    tasty-hunit
