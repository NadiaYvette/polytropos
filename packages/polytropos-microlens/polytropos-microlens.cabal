cabal-version: 3.14
name: polytropos-microlens
version: 0.1.0.0
synopsis: Lightweight microlens optics integration for polytropos open records
description:
  Lightweight optics integration between @polytropos@ open records and @microlens@.

  Designed specifically for codebases prioritizing fast compilation times and zero
  transitive dependency bloat: depends strictly on @base@, @microlens@, @polytropos-core@,
  and @polytropos-plugin@.

  Provides O(1) field lenses via @fieldLens@ (with slot indices emitted as literals
  by the TcPlugin) and homogeneous single-pass traversals over flat contiguous
  payload arrays via @each@.

  Start at the front door module @Polytropos.Microlens@ for complete documentation,
  usage guidelines, and worked examples.
license: EUPL-1.2 OR Apache-2.0
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Optics, Data
build-type: Simple

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Microlens
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    microlens >= 0.4 && < 0.5,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-microlens-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    microlens,
    polytropos-core,
    polytropos-microlens,
    polytropos-plugin,
    tasty,
    tasty-hunit
