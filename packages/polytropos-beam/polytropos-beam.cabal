cabal-version: 3.14
name: polytropos-beam
version: 0.1.0.0
build-type: Simple
synopsis: beam schema integration for polytropos open records
description:
  Satellite package enabling @polytropos@ open records to act as @beam@
  database schema tables without GHC out-of-memory compilation crashes on
  50+ columns: the 'Database.Beam.Schema.Tables.Beamable' instance works
  directly over the flat 'SmallArray' payload, so column count costs one
  array element, not one node of a generic-representation tree.
license: BSD-3-Clause

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Beam
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    beam-core >= 0.9,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-beam-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    beam-core,
    polytropos-core,
    polytropos-beam,
    polytropos-plugin,
    tasty,
    tasty-hunit
