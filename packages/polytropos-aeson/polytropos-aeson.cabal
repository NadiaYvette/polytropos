cabal-version: 3.14
name: polytropos-aeson
version: 0.1.0.0
synopsis: High-performance aeson JSON codecs for polytropos open records and variants
description:
  Linear O(N) @ToJSON@ and @FromJSON@ serialization codecs for @polytropos@ open
  records and variants via @aeson@.

  Unlike @GHC.Generics@ which builds intermediate binary tree nodes during serialization,
  @polytropos-aeson@ unrolls the flat contiguous @SmallArray@ payload directly into a
  JSON object and back. Variants serialize into tagged JSON objects with O(1) tag dispatch.

  Start at the front door module @Polytropos.Aeson@ for complete documentation,
  codec options, and worked examples.
license: EUPL-1.2 OR Apache-2.0
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Data, JSON
build-type: Simple

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Aeson
  ghc-options: -Wall
  build-depends:
    base >= 4.14 && < 5,
    aeson >= 2.0 && < 2.3,
    bytestring >= 0.10 && < 0.13,
    text >= 1.2 && < 2.2,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2

test-suite polytropos-aeson-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -fplugin=Polytropos.Plugin
  build-depends:
    base,
    aeson,
    bytestring,
    text,
    polytropos-core,
    polytropos-aeson,
    polytropos-plugin,
    tasty,
    tasty-hunit
