cabal-version: 3.14
name: polytropos-aeson
version: 0.1.0.0
build-type: Simple
synopsis: aeson JSON codecs for polytropos open records and variants
description:
  Satellite package providing linear O(N) @ToJSON@ and @FromJSON@ codecs for
  @polytropos@ open records and variants: unrolls the flat 'SmallArray'
  payload directly into a JSON object and back without a GHC.Generics tree,
  and encodes variants as tagged objects.
license: BSD-3-Clause

library
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules: Polytropos.Aeson
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    aeson >= 2.0,
    bytestring,
    text,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-aeson-test
  type: exitcode-stdio-1.0
  default-language: GHC2024
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    aeson,
    bytestring,
    text,
    polytropos-core,
    polytropos-aeson,
    polytropos-plugin,
    tasty,
    tasty-hunit
