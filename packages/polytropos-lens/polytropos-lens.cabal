cabal-version: 3.14
name: polytropos-lens
version: 0.1.0.0
build-type: Simple
synopsis: full lens-suite integration for polytropos open records and variants
description:
  Satellite package integrating @polytropos@ row-typed open records and
  variants with Edward Kmett's @lens@ library, while keeping the core
  packages free of the heavyweight transitive dependency tree: positional
  @Field1@..@Field9@ lenses, @At@/@Ixed@ keyed by field name, an @Each@
  traversal over homogeneous records, and profunctor prisms over sum
  variants.
license: BSD-3-Clause

library
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules: Polytropos.Lens
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    lens >= 5.2,
    profunctors,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-lens-test
  type: exitcode-stdio-1.0
  default-language: GHC2024
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    lens,
    polytropos-core,
    polytropos-lens,
    polytropos-plugin,
    profunctors,
    tasty,
    tasty-hunit
