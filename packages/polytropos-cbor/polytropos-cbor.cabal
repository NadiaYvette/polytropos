cabal-version: 3.14
name: polytropos-cbor
version: 0.1.0.0
build-type: Simple
synopsis: binary CBOR serialization for polytropos open records and variants
description:
  Satellite package providing high-performance binary CBOR serialization
  of @polytropos@ open records and variants via @cborg@/@serialise@: a
  length header plus flat payload field encodings for records, and a
  constructor Word tag plus selected payload fields for variants — no
  intermediate tree boxing anywhere.
license: BSD-3-Clause

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.CBOR
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    cborg == 0.2.*,
    serialise == 0.2.*,
    bytestring,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-cbor-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    cborg,
    serialise,
    bytestring,
    polytropos-core,
    polytropos-cbor,
    polytropos-plugin,
    tasty,
    tasty-hunit
