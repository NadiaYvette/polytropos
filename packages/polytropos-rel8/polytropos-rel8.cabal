cabal-version: 3.14
name: polytropos-rel8
version: 0.1.0.0
build-type: Simple
synopsis: rel8 Rel8able instances over polytropos open rows
description:
  Satellite package integrating @polytropos@ open rows with Oliver
  Charles' @rel8@ PostgreSQL framework. 'PolyRow' is a @Rel8able@ whose
  columns are derived directly from the row's type-level field list: the
  row maps to a right-nested 'HProduct' tree of 'HLabel'ed 'HIdentity'
  columns, one per field, named by the field's 'Symbol'. The erased
  'SmallArray' payload of the underlying 'Rep' is read and written slot
  by slot — one slot per column, in row order — so conversion to and
  from rel8's columnar representation never materialises an intermediate
  tuple and is unbounded in arity.
license: EUPL-1.2 OR Apache-2.0

library
  default-language: GHC2021
  hs-source-dirs: src
  exposed-modules: Polytropos.Rel8
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    primitive >= 0.7,
    text,
    rel8 >= 1.8,
    rel8-internal,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-rel8-test
  type: exitcode-stdio-1.0
  default-language: GHC2021
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    primitive,
    text,
    rel8,
    rel8-internal,
    polytropos-core,
    polytropos-rel8,
    polytropos-plugin,
    tasty,
    tasty-hunit
