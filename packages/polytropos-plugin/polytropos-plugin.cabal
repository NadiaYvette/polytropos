cabal-version:      3.0
name:               polytropos-plugin
version:            0.1.0.0
synopsis:           TcPlugin that emits literal evidence for Polytropos row classes
description:
  A GHC typechecker plugin for @polytropos@ that solves the evidence-class
  constraints (@'FieldIndex'@, @'ConstructorIndex'@, @'RowEq'@, @'RowShow'@,
  @'RowEqSum'@, @'RowShowSum'@) by inspecting the row carried in a
  @'RowRep'@'s type and emitting literal slot indices, tags, and comparison
  bodies — the same technique @large-anon@ uses for @DictRowHasField@.

  Uses the @ghc-tcplugin-api@ library for a streamlined interface to GHC's
  typechecker plugin API.

  Load with @ghc-options: -fplugin=Polytropos.Plugin@ in the consuming
  package's .cabal file.
license:            BSD-3-Clause
author:             Nadia Yvette Chambers
maintainer:         nadia.yvette.chambers@ik.me
category:           Compiler Plugin
extra-doc-files:    CHANGELOG.md

common warnings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wredundant-constraints
      -Wunused-packages

library
  import:           warnings
  exposed-modules:  Polytropos.Plugin
  hs-source-dirs:   src
  default-language: GHC2021
  build-depends:
      base       >= 4.19 && < 4.23
    , ghc         >= 9.14 && < 9.15
    , ghc-tcplugin-api >= 0.1 && < 0.21
    , polytropos-core
    , primitive   >= 0.9  && < 0.10

test-suite polytropos-plugin-smoke
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   tests/smoke
  main-is:          Main.hs
  default-language: GHC2021
  build-depends:
      base       >= 4.19 && < 4.23
    , polytropos-core
    , primitive
    , tasty         >= 1.4  && < 1.6
    , tasty-hunit   >= 0.10 && < 0.11
    , polytropos-plugin

  ghc-options:
      -fplugin=Polytropos.Plugin
