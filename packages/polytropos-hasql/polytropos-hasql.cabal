cabal-version: 3.14
name: polytropos-hasql
version: 0.1.0.0
build-type: Simple
synopsis: hasql row decoders for polytropos open records
description:
  Satellite package integrating @polytropos@ open records with the
  high-performance PostgreSQL driver @hasql@. 'recordRow' builds a hasql
  'Hasql.Decoders.Row' decoder that consumes one column per row field, in
  row order, and packs the decoded values straight into the contiguous
  'SmallArray' payload of the record — no intermediate tuples and no GHC's
  62-column tuple limit, because the column decoders are combined by a
  constraint walk rather than a tuple constructor.
license: BSD-3-Clause

library
  default-language: GHC2024
  hs-source-dirs: src
  exposed-modules: Polytropos.Hasql
  ghc-options: -Wall -Werror
  build-depends:
    base >= 4.14 && < 5,
    hasql >= 1.6,
    polytropos-core,
    polytropos-plugin

test-suite polytropos-hasql-test
  type: exitcode-stdio-1.0
  default-language: GHC2024
  hs-source-dirs: test
  main-is: Main.hs
  ghc-options: -Wall -Werror -fplugin=Polytropos.Plugin
  build-depends:
    base,
    bytestring,
    text,
    polytropos-core,
    polytropos-hasql,
    polytropos-plugin,
    -- postgresql-binary is hasql's codec backend: the per-column binary
    -- payload decoding in the tests runs through the same machinery
    -- hasql's value decoders use, so column consumption is simulated at
    -- the exact wire format a live PostgreSQL server would send.
    postgresql-binary,
    tasty,
    tasty-hunit
