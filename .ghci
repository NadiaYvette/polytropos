:set -fplugin=Polytropos.Plugin
:set -XAllowAmbiguousTypes
:set -XApplicativeDo
:set -XArrows
:set -XBlockArguments
:set -XDataKinds
:set -XDeriveAnyClass
:set -XDerivingStrategies
:set -XDerivingVia
:set -XFlexibleContexts
:set -XFlexibleInstances
:set -XGHC2024
:set -XImportQualifiedPost
:set -XLambdaCase
:set -XLinearTypes
:set -XMultiWayIf
:set -XNamedFieldPuns
:set -XOrPatterns
:set -XOverloadedLabels
:set -XOverloadedRecordDot
:set -XPackageImports
:set -XPartialTypeSignatures
:set -XQuasiQuotes
:set -XRankNTypes
:set -XRecordWildCards
:set -XRequiredTypeArguments
:set -XRoleAnnotations
:set -XStandaloneDeriving
:set -XStandaloneKindSignatures
:set -XTemplateHaskellQuotes
:set -XTupleSections
:set -XTypeApplications
:set -XTypeFamilyDependencies
:set -XTypeOperators
:set -XTypeSynonymInstances
:set -XUnicodeSyntax
:set -XViewPatterns
:set -fobject-code
:set prompt "\ESC[1;35mpolytropos\ESC[0m> "
import Polytropos
