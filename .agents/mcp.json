{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "tricorder": {
      "command": "tricorder-mcp"
    },
    "contextful": {
      "command": "cxf",
      "args": ["server"]
    },
    "codegraph": {
      "command": "codegraph-mcp",
      "args": ["--mcp", "-w", "."]
    },
    "open-kioku": {
      "command": "open-kioku",
      "args": ["mcp", "serve", "--repo", "."]
    },
    "haskell-language-server": {
      "command": "haskell-language-server",
      "args": ["--lsp"]
    }
  }
}
